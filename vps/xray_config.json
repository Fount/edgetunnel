{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  "inbounds": [
    {
      "tag": "vless-ws-in",
      "port": 10000,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "%%UUID%%"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/api-stream"
        }
      }
    },
    {
      "tag": "vless-reality-in",
      "port": 9443,
      "listen": "0.0.0.0",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "%%UUID%%",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "gateway.icloud.com:443",
          "xver": 0,
          "serverNames": [
            "gateway.icloud.com"
          ],
          "privateKey": "%%REALITY_PRIVATE_KEY%%",
          "shortIds": [
            "%%REALITY_SHORT_ID%%"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "tag": "warp-out",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "%%WARP_SECRET_KEY%%",
        "address": [
          "%%WARP_V4%%",
          "%%WARP_V6%%"
        ],
        "peers": [
          {
            "publicKey": "%%WARP_PEER_PUB%%",
            "endpoint": "%%WARP_ENDPOINT%%"
          }
        ],
        "kernelMode": false
      }
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "outboundTag": "warp-out",
        "domain": [
          "domain:vastnext.com",
          "vastnext.com"
        ]
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
  }
}
